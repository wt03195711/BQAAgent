<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBgPrimary"
    android:orientation="vertical">

    <io.agents.bqaagent.widget.CommonToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/colorTextTertiary"
        android:textSize="12dp"
        tools:text="4 segments · 8m12s · 720x1560 · overlap trimmed" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="UnsafeOptInUsageError" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorBgPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSteps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13dp"
            tools:text="12 steps" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/colorBorderBase" />

        <TextView
            android:id="@+id/btnSaveGallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="Save to Photos"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/colorBorderBase" />

        <TextView
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="Share"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13dp" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollMarkers"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/colorBgPrimary"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/llMarkers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />

    </ScrollView>

</LinearLayout>