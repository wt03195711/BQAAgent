<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 待命：圆形展示，仅系统 Logo（直径与运行态胶囊厚度一致 = 56dp） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardIdle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/float_bg"
        app:strokeColor="@color/float_border"
        app:strokeWidth="2dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ivIdleLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/bqa_agent_icon" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 运行：胶囊（与圆形同厚度 56dp，横向拉长）；停止按钮最左，Step 固定，意图自适应 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardActive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/float_bg"
        app:strokeColor="@color/float_border"
        app:strokeWidth="2dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/activeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- 独立停止按钮：图标展示；左侧吸附时在最左，右侧吸附时随容器镜像到最右 -->
            <ImageView
                android:id="@+id/btnStop"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_float_stop"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/chat_stop"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_stop"
                app:tint="@color/float_stop_text" />

            <!-- 文字块：内部强制 LTR，保证 Step N · 意图 顺序与 scrollX 揭示末尾逻辑不受容器镜像影响 -->
            <LinearLayout
                android:id="@+id/activeTextContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="ltr"
                android:textDirection="ltr">

                <!-- Step N：固定展示，不参与滚动 -->
                <TextView
                    android:id="@+id/tvStep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Step 1"
                    android:textColor="@color/float_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 意图信息：宽度随内容自适应，最多 160dp；超过才用 scrollX 滑动展示，且不使用省略号 -->
                <TextView
                    android:id="@+id/tvIntent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="160dp"
                    android:singleLine="true"
                    android:scrollHorizontally="true"
                    android:textColor="@color/float_text"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
